{
  "manifest_version": 3,
  "name": "轻存 · 视频下载助手",
  "version": "2.3.14",
  "description": "多平台视频下载、导演账号与中文镜头标签：运镜、景别、冷暖色调。",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting",
    "alarms",
    "cookies"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "轻存 · 下载视频"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
